# Meminno — documented env vars (no real values; copy to .env.local and fill in)
# .env.local is gitignored. See CLAUDE.md "Key refs" for the credential-reuse map.

# Supabase (project: meminno, ref: hlaeqvuyapkvixwaqxcs, us-west-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supavisor transaction pooler, IPv4/Vercel-compatible — see lib/db/index.ts)
# Two roles, deliberately split (MEM-002-fix, issue #14 — see CLAUDE.md's
# "Two-role database architecture"):
#   DATABASE_URL           -> meminno_rls  — the app's RUNTIME role. Owns nothing,
#                             no BYPASSRLS, explicit per-table grants only, so every
#                             RLS policy genuinely applies to it. This is what
#                             lib/db/index.ts and Vercel use.
#   MIGRATION_DATABASE_URL -> meminno_app  — the table-OWNING migration/ops role,
#                             used only by drizzle-kit. Not needed at runtime; do
#                             not set it in Vercel.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# OpenAI (AI generation — notes/flashcards/quiz/chat)
OPENAI_API_KEY=

# MEM-014: Google Gemini API key, used by lib/podcastAudio.ts for the podcast
# feature's multi-speaker text-to-speech call (model
# gemini-2.5-flash-preview-tts). This is the only path in the app that bills a
# vendor other than OpenAI, so it sits behind its own two-layer cap in
# lib/podcastLimits.ts, per CLAUDE.md HARD STOP 6. Get one from Google AI
# Studio (aistudio.google.com/apikey). Already set in Vercel Production by
# Pranav directly; still needed locally to exercise real generation. With it
# unset, lib/podcastAudio.ts fails closed with `not_configured` rather than
# throwing. Never commit a real value.
GEMINI_API_KEY=

# Stripe (dedicated Meminno account — still pending human setup as of MEM-001)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs set in MEM-004 once pricing is finalized (see CLAUDE.md)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMESTER=

# Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Rate limiting + AI-generation budget caps (shared Upstash Redis instance with
# Propinno — see lib/ratelimit.ts / lib/aiBudget.ts, all keys namespaced `meminno-`)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=meminno

# MEM-009: HMAC key for signing/verifying the shareable stat-card image's
# query params (lib/stats.ts) — required in every environment that either
# builds a share URL (server components/actions) or verifies one
# (app/api/stat-card, app/share/stat-card). A strong random value, e.g.
# `openssl rand -hex 32`. Never commit a real value.
STAT_CARD_SIGNING_SECRET=
